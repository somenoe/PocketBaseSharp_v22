@page "/health"
@inject DemoPocketBaseService Demo

<PageTitle>Health</PageTitle>

<FeatureHero Title="Health Check"
             Description="A minimal probe against the PocketBase API. This page exercises HealthService.CheckHealthAsync and surfaces the raw model returned by the SDK."
             Eyebrow="Service page" Service="HealthService" Method="CheckHealthAsync()" Access="Public">
    <div class="rounded-[1.5rem] bg-slate-950 p-5 text-white shadow-[0_24px_70px_-36px_rgba(15,23,42,0.85)]">
        <p class="text-xs uppercase tracking-[0.3em] text-orange-200">Latest status</p>
        <div class="mt-3 flex items-center gap-3">
            <span class="font-display text-4xl font-semibold">@(health?.Code?.ToString() ?? "--")</span>
            @if (health?.Code is int code)
            {
                <Badge Color="@(code >= 200 && code < 300 ? BadgeColor.Success : BadgeColor.Warning)">HTTP @(code)</Badge>
            }
        </div>
        <p class="mt-3 text-sm text-slate-300">The bundled PocketBase tests use the same endpoint as their first live
            assertion, so this is the fastest way to confirm the local server is reachable.</p>
        </div>
    </FeatureHero>

    <StatusAlert Message="@statusMessage" IsError="@isError" />

    <div class="grid gap-6 xl:grid-cols-[0.85fr_1.15fr]">
        <Card Class="panel-surface p-5">
            <p class="section-kicker">Action</p>
            <h2 class="font-display text-2xl font-semibold text-slate-900 dark:text-white">Probe the server</h2>
            <p class="mt-3 text-sm text-slate-600 dark:text-slate-300">Run the call again to verify that the demo can reach
                <span class="font-semibold">@Demo.BaseUrl</span> and to update the request inspector in the header.
            </p>

            <div class="mt-6 flex flex-wrap items-center gap-3">
                <Button Color="ButtonColor.Primary" Loading="@loading" OnClick="RunHealthCheckAsync">
                    Run health check
                </Button>
                @if (health?.Message is { Length: > 0 } message)
                {
                    <Badge Color="BadgeColor.Info">@message</Badge>
                }
            </div>

            <dl class="mt-6 grid gap-4 sm:grid-cols-2">
                <div>
                    <dt class="text-xs uppercase tracking-[0.26em] text-slate-500 dark:text-slate-400">Request path</dt>
                    <dd class="mt-1 text-slate-700 dark:text-slate-200">@(Demo.LastRequestPath ?? "/api/health")</dd>
                </div>
                <div>
                    <dt class="text-xs uppercase tracking-[0.26em] text-slate-500 dark:text-slate-400">Observed status</dt>
                    <dd class="mt-1 text-slate-700 dark:text-slate-200">@(Demo.LastStatusCode is null ? "Pending" :
                                                                        $"{(int)Demo.LastStatusCode} {Demo.LastStatusCode}")</dd>
                    </div>
                </dl>
            </Card>

            <ResultCard Title="Health payload" Description="Raw ApiHealthModel content from the SDK call." Json="@healthJson"
                        EmptyMessage="The page runs an initial probe on load, but you can rerun it any time." />
        </div>

@code {
    private ApiHealthModel? health;
    private string? healthJson;
    private string? statusMessage;
    private bool isError;
    private bool loading;

    protected override async Task OnInitializedAsync()
    {
        await RunHealthCheckAsync();
    }

    private async Task RunHealthCheckAsync()
    {
        loading = true;
        var result = await Demo.Client.Health.CheckHealthAsync();
        loading = false;

        if (result.IsSuccess)
        {
            health = result.Value;
            healthJson = Demo.ToJson(result.Value);
            statusMessage = $"Health endpoint returned HTTP {result.Value.Code}.";
            isError = false;
            return;
        }

        statusMessage = Demo.Describe(result);
        isError = true;
    }
}
