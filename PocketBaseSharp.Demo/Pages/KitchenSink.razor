@page "/components"
@inject DemoPocketBaseService Demo

<PageTitle>Components</PageTitle>

<Drawer Show="@isDrawerOpen" Position="@drawerPosition" OnClose="CloseDrawer">
    <DrawerHeader>@DrawerHeading</DrawerHeader>
    <DrawerItems>
        <div class="space-y-5">
            <Alert Color="AlertColor.Info"
                   Icon="@(new InfoCircleIcon())"
                   TextEmphasis="Live overlay"
                   Text="The drawer preview is wired to the same local components used across the rest of the demo shell." />

            <Sidebar Class="w-full rounded-[1.5rem] border border-panel-strong-border bg-panel-strong-foreground/10 px-3 py-3 shadow-none">
                <SidebarItemGroup>
                    @foreach (var drawerLink in drawerLinks)
                    {
                        <SidebarItem Href="@drawerLink.Href" Icon="@drawerLink.Icon">
                            @drawerLink.Label
                        </SidebarItem>
                    }
                </SidebarItemGroup>

                <SidebarCTA>
                    <div class="space-y-3">
                        <p class="text-sm text-muted-foreground">Use the preview drawer to verify the component behaves the same from either edge of the viewport.</p>
                        <Button Color="ButtonColor.Primary" OnClick="CloseDrawer">Close preview</Button>
                    </div>
                </SidebarCTA>
            </Sidebar>
        </div>
    </DrawerItems>
</Drawer>

<FeatureHero Title="Component Kitchen Sink"
             Description="A long-form route that exercises every local UI primitive in the demo project. Enum-based variants are shown side by side, boolean switches get both states, and interactive components update live state on the page."
             Eyebrow="Design system lab"
             Service="Demo.Components"
             Method="All local building blocks"
             Access="Public route">
    <div class="rounded-[1.5rem] border border-panel-strong-border bg-[image:var(--gradient-panel)] p-5 text-panel-strong-foreground shadow-[0_24px_70px_-36px_rgba(15,23,42,0.85)]">
        <div class="flex items-start justify-between gap-4">
            <div>
                <p class="text-xs uppercase tracking-[0.3em] text-primary/80">Coverage</p>
                <p class="mt-2 font-['Space_Grotesk','Segoe_UI',sans-serif] text-2xl font-semibold">All local demo components</p>
            </div>

            <Badge Color="@(Demo.IsAuthenticated ? BadgeColor.Success : BadgeColor.Gray)">@Demo.SessionKind</Badge>
        </div>

        <p class="mt-4 text-sm text-panel-strong-muted">This page is intentionally long so each component has enough room for meaningful examples instead of a token single-state preview.</p>

        <div class="mt-5 flex flex-wrap gap-2">
            <Badge Color="BadgeColor.Success">Interactive</Badge>
            <Badge Color="BadgeColor.Info">Full-page test target</Badge>
            <Badge Color="BadgeColor.Gray">@($"{iconSamples.Length} icons in UiTypes")</Badge>
        </div>
    </div>
</FeatureHero>

<StatusAlert Message="@interactionMessage" IsError="@isInteractionError" IsWarning="@isInteractionWarning" />

<Toolbar Embedded="true"
         Class="rounded-[1.5rem] border border-border/70 bg-card/80 px-5 py-4 shadow-[0_28px_80px_-44px_rgba(15,23,42,0.35)] backdrop-blur-xl   dark:shadow-[0_30px_90px_-42px_rgba(0,0,0,0.9)]">
    <ChildContent>
        <div class="flex flex-wrap items-center gap-2">
            <Button Color="ButtonColor.Primary" OnClick="OpenLeftDrawer">Open left drawer</Button>
            <Button Variant="ButtonVariant.Outline" Color="ButtonColor.Dark" OnClick="OpenRightDrawer">Open right drawer</Button>
            <Button Variant="ButtonVariant.Outline" Color="ButtonColor.Gray" OnClick="ResetShowcase">Reset demo state</Button>
        </div>
    </ChildContent>
    <End>
        <div class="flex flex-wrap items-center gap-2">
            <Badge Color="@selectedBadgeColor">Palette: @selectedBadgeColor</Badge>
            <Badge Color="BadgeColor.Gray">Drawer: @(isDrawerOpen ? drawerPosition.ToString() : "Closed")</Badge>
        </div>
    </End>
</Toolbar>

<section id="cards" class="space-y-4">
    <div>
        <p class="mb-1.5 text-[0.72rem] font-bold uppercase tracking-[0.26em] text-primary">Card</p>
        <h2 class="font-['Space_Grotesk','Segoe_UI',sans-serif] text-3xl font-semibold text-foreground">Jump cards and static panels</h2>
        <p class="mt-3 text-sm text-muted-foreground">The card component supports static and linked surfaces. These jump cards double as a table of contents for the rest of the page.</p>
    </div>

    <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
        @foreach (var quickLink in quickLinks)
        {
            <Card Href="@quickLink.Href"
                  Class="min-w-0 rounded-[1.5rem] border border-border/35 bg-[image:var(--gradient-surface)] p-5 shadow-[0_24px_60px_-40px_rgba(15,23,42,0.3)] transition-transform duration-200 hover:-translate-y-1 dark:shadow-[0_24px_60px_-40px_rgba(0,0,0,0.35)]">
                <div class="flex items-start justify-between gap-3">
                    <div>
                        <p class="mb-1.5 text-[0.72rem] font-bold uppercase tracking-[0.26em] text-primary">Quick jump</p>
                        <h3 class="font-['Space_Grotesk','Segoe_UI',sans-serif] text-2xl font-semibold text-foreground">@quickLink.Title</h3>
                    </div>

                    <IconRenderer Icon="@quickLink.Icon" Class="h-5 w-5 text-primary" />
                </div>

                <p class="mt-3 text-sm text-muted-foreground">@quickLink.Copy</p>
            </Card>
        }
    </div>

    <Card Class="rounded-[1.5rem] border border-border/70 bg-card/80 p-5 shadow-[0_28px_80px_-44px_rgba(15,23,42,0.35)] backdrop-blur-xl   dark:shadow-[0_30px_90px_-42px_rgba(0,0,0,0.9)]">
        <p class="mb-1.5 text-[0.72rem] font-bold uppercase tracking-[0.26em] text-primary">Static surface</p>
        <h3 class="font-['Space_Grotesk','Segoe_UI',sans-serif] text-2xl font-semibold text-foreground">Cards can frame content without acting like navigation</h3>
        <p class="mt-3 text-sm text-muted-foreground">This static example is here purely to show the non-linked mode next to the linked jump cards above.</p>
    </Card>
</section>

<section id="feedback" class="space-y-4">
    <div>
        <p class="mb-1.5 text-[0.72rem] font-bold uppercase tracking-[0.26em] text-primary">Feedback</p>
        <h2 class="font-['Space_Grotesk','Segoe_UI',sans-serif] text-3xl font-semibold text-foreground">Alerts, badges, avatars, and state summaries</h2>
        <p class="mt-3 text-sm text-muted-foreground">These are the small identity and feedback surfaces that appear throughout the rest of the demo pages.</p>
    </div>

    <div class="grid gap-6 xl:grid-cols-[1.05fr_0.95fr]">
        <Card Class="rounded-[1.5rem] border border-border/70 bg-card/80 p-5 shadow-[0_28px_80px_-44px_rgba(15,23,42,0.35)] backdrop-blur-xl   dark:shadow-[0_30px_90px_-42px_rgba(0,0,0,0.9)]">
            <p class="mb-1.5 text-[0.72rem] font-bold uppercase tracking-[0.26em] text-primary">Alert + StatusAlert</p>
            <h3 class="font-['Space_Grotesk','Segoe_UI',sans-serif] text-2xl font-semibold text-foreground">Color variants and wrapper states</h3>

            <div class="mt-5 space-y-3">
                <Alert Color="AlertColor.Info" Icon="@(new InfoCircleIcon())" TextEmphasis="Info" Text="Use informational alerts for neutral guidance and runbook steps." />

                <Alert Color="AlertColor.Warning" Icon="@(new ExclamationTriangleIcon())" TextEmphasis="Warning" Text="Warnings keep the user moving while calling out that a choice deserves attention." WithBorderAccent="true" />

                <Alert Color="AlertColor.Success" Icon="@(new CheckCircleIcon())" TextEmphasis="Success" Text="Success alerts work well for completed requests and durable state changes." />

                <Alert Color="AlertColor.Failure"
                       Icon="@(new ExclamationTriangleIcon())"
                       TextEmphasis="Failure"
                       Text="Failure alerts can carry extra content via ChildContent."
                       WithBorderAccent="true">
                    <div class="mt-3 flex flex-wrap gap-2">
                        <Badge Color="BadgeColor.Pink">Escalate</Badge>
                        <Badge Color="BadgeColor.Gray">Retry available</Badge>
                    </div>
                </Alert>
            </div>

            <div class="mt-6 space-y-3">
                <StatusAlert Message="StatusAlert defaults to a success treatment when no error flags are set." />
                <StatusAlert Message="Warnings flip the wrapper to amber while keeping the component API compact." IsWarning="true" />
                <StatusAlert Message="Errors map to the failure palette and the triangle icon." IsError="true" />
            </div>
        </Card>

        <Card Class="rounded-[1.5rem] border border-border/70 bg-card/80 p-5 shadow-[0_28px_80px_-44px_rgba(15,23,42,0.35)] backdrop-blur-xl   dark:shadow-[0_30px_90px_-42px_rgba(0,0,0,0.9)]">
            <p class="mb-1.5 text-[0.72rem] font-bold uppercase tracking-[0.26em] text-primary">Badge + Avatar</p>
            <h3 class="font-['Space_Grotesk','Segoe_UI',sans-serif] text-2xl font-semibold text-foreground">Palette chips and identity treatments</h3>

            <div class="mt-5 flex flex-wrap gap-2">
                @foreach (var badgeColor in badgeColors)
                {
                    <Badge Color="@badgeColor">@badgeColor</Badge>
                }
            </div>

            <div class="mt-5 flex flex-wrap gap-2">
                @foreach (var badgeColor in badgeColors)
                {
                    <Button Size="ButtonSize.Small"
                            Variant="ButtonVariant.Outline"
                            Color="@(badgeColor == selectedBadgeColor ? ButtonColor.Primary : ButtonColor.Gray)"
                            OnClick="@(() => SelectBadgeColor(badgeColor))">
                        @badgeColor
                    </Button>
                }
            </div>

            <div class="mt-6 grid gap-4 sm:grid-cols-2">
                <div class="rounded-[1.25rem] border border-border/35 bg-card/70 p-4  ">
                    <p class="text-xs uppercase tracking-[0.24em] text-muted-foreground/85">Default avatar</p>
                    <div class="mt-4 flex items-center gap-3">
                        <Avatar Image="favicon.svg" Alt="PocketBaseSharp mark" />
                        <div>
                            <p class="font-semibold text-foreground">Rounded-2xl surface</p>
                            <p class="text-sm text-muted-foreground">Useful when the image should read like an app tile.</p>
                        </div>
                    </div>
                </div>

                <div class="rounded-[1.25rem] border border-border/35 bg-card/70 p-4  ">
                    <p class="text-xs uppercase tracking-[0.24em] text-muted-foreground/85">Rounded avatar</p>
                    <div class="mt-4 flex items-center gap-3">
                        <Avatar Rounded="true" Image="favicon.svg" Alt="PocketBaseSharp mark" />
                        <div>
                            <p class="font-semibold text-foreground">Circular identity</p>
                            <p class="text-sm text-muted-foreground">Use the Rounded flag when the asset should behave like a profile marker.</p>
                        </div>
                    </div>
                </div>
            </div>
        </Card>
    </div>
</section>

<section id="inputs" class="space-y-4">
    <div>
        <p class="mb-1.5 text-[0.72rem] font-bold uppercase tracking-[0.26em] text-primary">Inputs</p>
        <h2 class="font-['Space_Grotesk','Segoe_UI',sans-serif] text-3xl font-semibold text-foreground">Buttons, labels, text inputs, and toggles</h2>
        <p class="mt-3 text-sm text-muted-foreground">This section covers the primary interactive entry points used across the sample application.</p>
    </div>

    <Card Class="rounded-[1.5rem] border border-border/70 bg-card/80 p-5 shadow-[0_28px_80px_-44px_rgba(15,23,42,0.35)] backdrop-blur-xl   dark:shadow-[0_30px_90px_-42px_rgba(0,0,0,0.9)]">
        <p class="mb-1.5 text-[0.72rem] font-bold uppercase tracking-[0.26em] text-primary">Button</p>
        <h3 class="font-['Space_Grotesk','Segoe_UI',sans-serif] text-2xl font-semibold text-foreground">Color, variant, size, loading, disabled, and link states</h3>

        <div class="mt-5 grid gap-6 xl:grid-cols-2">
            <div class="space-y-4">
                <div>
                    <p class="text-xs uppercase tracking-[0.24em] text-muted-foreground/85">Default variant</p>
                    <div class="mt-3 flex flex-wrap gap-2">
                        @foreach (var buttonColor in buttonColors)
                        {
                            <Button Color="@buttonColor" OnClick="@(() => Announce($"Pressed a {buttonColor} default button."))">
                                @buttonColor
                            </Button>
                        }
                    </div>
                </div>

                <div>
                    <p class="text-xs uppercase tracking-[0.24em] text-muted-foreground/85">Outline variant</p>
                    <div class="mt-3 flex flex-wrap gap-2">
                        @foreach (var buttonColor in buttonColors)
                        {
                            <Button Variant="ButtonVariant.Outline" Color="@buttonColor" OnClick="@(() => Announce($"Pressed a {buttonColor} outline button."))">
                                @buttonColor
                            </Button>
                        }
                    </div>
                </div>
            </div>

            <div>
                <p class="text-xs uppercase tracking-[0.24em] text-muted-foreground/85">Size and state combinations</p>
                <div class="mt-3 flex flex-wrap gap-2">
                    <Button Size="ButtonSize.Small" Color="ButtonColor.Primary" OnClick="@(() => Announce("Pressed a small action button."))">Small action</Button>
                    <Button Variant="ButtonVariant.Outline" Color="ButtonColor.Gray" Disabled="true">Disabled</Button>
                    <Button Color="ButtonColor.Dark" Loading="true">Loading</Button>
                    <Button Href="/health" Variant="ButtonVariant.Outline" Color="ButtonColor.Gray">Href link</Button>
                    <Button Color="ButtonColor.Red" OnClick="@(() => Announce("Triggered the high-emphasis action state.", warning: true))">
                        <RocketIcon class="h-4 w-4" />
                        <span>Trigger notice</span>
                    </Button>
                </div>
            </div>
        </div>
    </Card>

    <Card Class="rounded-[1.5rem] border border-border/70 bg-card/80 p-5 shadow-[0_28px_80px_-44px_rgba(15,23,42,0.35)] backdrop-blur-xl   dark:shadow-[0_30px_90px_-42px_rgba(0,0,0,0.9)]">
        <p class="mb-1.5 text-[0.72rem] font-bold uppercase tracking-[0.26em] text-primary">Label + TextInput + ToggleSwitch</p>
        <h3 class="font-['Space_Grotesk','Segoe_UI',sans-serif] text-2xl font-semibold text-foreground">Bound values, on-change vs on-input, icons, disabled mode, and toggle states</h3>

        <div class="mt-5 grid gap-5 xl:grid-cols-3">
            <div>
                <div class="mb-2 block">
                    <Label For="kitchen-email" Value="OnChange input" />
                </div>
                <TextInput TValue="string" Id="kitchen-email" @bind-Value="onChangeValue" Type="email" Placeholder="admin@admin.com" />
                <p class="mt-3 text-sm text-muted-foreground">Committed value: @onChangeValue</p>
            </div>

            <div>
                <div class="mb-2 block">
                    <Label For="kitchen-search">
                        <span class="inline-flex items-center gap-2">
                            <SearchIcon class="h-4 w-4" />
                            <span>OnInput search</span>
                        </span>
                    </Label>
                </div>
                <TextInput TValue="string"
                           Id="kitchen-search"
                           @bind-Value="onInputValue"
                           Behavior="InputBehavior.OnInput"
                           DebounceDelay="200"
                           Placeholder="Search the component catalog"
                           Icon="@(new SearchIcon())" />
                <p class="mt-3 text-sm text-muted-foreground">Live value: @onInputValue</p>
            </div>

            <div>
                <div class="mb-2 block">
                    <Label For="kitchen-password" Value="Disabled password input" />
                </div>
                <TextInput TValue="string"
                           Id="kitchen-password"
                           @bind-Value="disabledPasswordValue"
                           Type="password"
                           Disabled="true"
                           Placeholder="Disabled preview" />
                <p class="mt-3 text-sm text-muted-foreground">Disabled fields inherit the same visual treatment with reduced emphasis.</p>
            </div>
        </div>

        <div class="mt-6 flex flex-wrap items-center gap-6">
            <ToggleSwitch @bind-Checked="primaryToggle" Label="Primary toggle" />
            <ToggleSwitch @bind-Checked="secondaryToggle" Label="Secondary toggle" />
            <Badge Color="@(primaryToggle ? BadgeColor.Success : BadgeColor.Warning)">Primary: @(primaryToggle ? "On" : "Off")</Badge>
            <Badge Color="@(secondaryToggle ? BadgeColor.Info : BadgeColor.Gray)">Secondary: @(secondaryToggle ? "On" : "Off")</Badge>
        </div>
    </Card>
</section>

<section id="navigation" class="space-y-4">
    <div>
        <p class="mb-1.5 text-[0.72rem] font-bold uppercase tracking-[0.26em] text-primary">Navigation</p>
        <h2 class="font-['Space_Grotesk','Segoe_UI',sans-serif] text-3xl font-semibold text-foreground">Breadcrumbs, navbars, sidebars, toolbars, tooltips, and dropdowns</h2>
        <p class="mt-3 text-sm text-muted-foreground">These examples mirror the shell patterns already used by the rest of the demo application.</p>
    </div>

    <Card Class="rounded-[1.5rem] border border-border/70 bg-card/80 p-5 shadow-[0_28px_80px_-44px_rgba(15,23,42,0.35)] backdrop-blur-xl   dark:shadow-[0_30px_90px_-42px_rgba(0,0,0,0.9)]">
        <div class="grid gap-6 xl:grid-cols-[0.9fr_1.1fr]">
            <div class="space-y-6">
                <div>
                    <p class="text-xs uppercase tracking-[0.24em] text-muted-foreground/85">Breadcrumb + BreadcrumbItem</p>
                    <Breadcrumb>
                        <BreadcrumbItem Href="/">
                            <span class="inline-flex items-center gap-2 leading-none">
                                <HomeIcon class="h-4 w-4" />
                                <span>Home</span>
                            </span>
                        </BreadcrumbItem>
                        <BreadcrumbItem Href="/components">
                            <span class="leading-none">Components</span>
                        </BreadcrumbItem>
                        <BreadcrumbItem>
                            <span class="leading-none">Kitchen sink</span>
                        </BreadcrumbItem>
                    </Breadcrumb>
                </div>

                <div>
                    <p class="text-xs uppercase tracking-[0.24em] text-muted-foreground/85">Toolbar</p>
                    <Toolbar Class="rounded-[1.25rem] border border-border/60 bg-card/55 px-4 py-3  ">
                        <ChildContent>
                            <div class="flex flex-wrap items-center gap-2">
                                <Button Size="ButtonSize.Small" Color="ButtonColor.Primary" OnClick="@(() => Announce("Toolbar primary action fired."))">Primary action</Button>
                                <Button Size="ButtonSize.Small" Variant="ButtonVariant.Outline" Color="ButtonColor.Gray" Href="/records">Open records</Button>
                            </div>
                        </ChildContent>
                        <End>
                            <Badge Color="BadgeColor.Info">Standalone toolbar</Badge>
                        </End>
                    </Toolbar>
                </div>
            </div>

            <div>
                <p class="text-xs uppercase tracking-[0.24em] text-muted-foreground/85">Navbar + NavbarBrand</p>
                <Navbar Class="rounded-[1.5rem] border border-border/70 bg-card/85 px-4 py-4 shadow-[0_24px_80px_-32px_rgba(15,23,42,0.35)] backdrop-blur   dark:shadow-[0_24px_90px_-36px_rgba(0,0,0,0.9)]">
                    <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
                        <NavbarBrand Href="/components">
                            <div class="flex items-center gap-4">
                                <div class="grid h-11 w-11 place-items-center rounded-2xl bg-[linear-gradient(135deg,#ea580c,#f59e0b_56%,#14b8a6)] font-['Space_Grotesk','Segoe_UI',sans-serif] text-sm font-bold tracking-[0.18em] text-white shadow-[0_20px_40px_-24px_rgba(194,65,12,0.75)]">UI</div>
                                <div>
                                    <div class="font-['Space_Grotesk','Segoe_UI',sans-serif] text-lg font-semibold tracking-tight text-foreground">Kitchen sink</div>
                                    <div class="text-xs uppercase tracking-[0.28em] text-muted-foreground/85">Local component catalog</div>
                                </div>
                            </div>
                        </NavbarBrand>

                        <div class="flex flex-wrap items-center gap-2">
                            <Badge Color="BadgeColor.Gray">Public route</Badge>
                            <Button Size="ButtonSize.Small" Variant="ButtonVariant.Outline" Color="ButtonColor.Gray" Href="#icons">Jump to icons</Button>
                            <Button Size="ButtonSize.Small" Color="ButtonColor.Primary" OnClick="@(() => Announce("Navbar action triggered."))">Preview action</Button>
                        </div>
                    </div>
                </Navbar>
            </div>
        </div>
    </Card>

    <div class="grid gap-6 xl:grid-cols-[0.88fr_1.12fr]">
        <Card Class="rounded-[1.5rem] border border-border/70 bg-card/80 p-5 shadow-[0_28px_80px_-44px_rgba(15,23,42,0.35)] backdrop-blur-xl   dark:shadow-[0_30px_90px_-42px_rgba(0,0,0,0.9)]">
            <p class="mb-1.5 text-[0.72rem] font-bold uppercase tracking-[0.26em] text-primary">Sidebar + SidebarItemGroup + SidebarItem + SidebarCTA</p>
            <h3 class="font-['Space_Grotesk','Segoe_UI',sans-serif] text-2xl font-semibold text-foreground">Section index</h3>

            <Sidebar Class="mt-5 w-full rounded-[1.5rem] border border-border/35 bg-card/70 px-3 py-3">
                <SidebarItemGroup>
                    @foreach (var quickLink in sidebarLinks)
                    {
                        <SidebarItem Href="@quickLink.Href" Icon="@quickLink.Icon">
                            @quickLink.Label
                        </SidebarItem>
                    }
                </SidebarItemGroup>

                <SidebarCTA>
                    <div class="space-y-3">
                        <p class="text-sm text-muted-foreground">The CTA slot is useful when the nav also needs a high-signal recommendation.</p>
                        <Button Href="#storytelling" Color="ButtonColor.Primary" Class="w-full">Open result cards</Button>
                    </div>
                </SidebarCTA>
            </Sidebar>
        </Card>

        <Card Class="rounded-[1.5rem] border border-border/70 bg-card/80 p-5 shadow-[0_28px_80px_-44px_rgba(15,23,42,0.35)] backdrop-blur-xl   dark:shadow-[0_30px_90px_-42px_rgba(0,0,0,0.9)]">
            <p class="mb-1.5 text-[0.72rem] font-bold uppercase tracking-[0.26em] text-primary">Tooltip + Dropdown + Drawer</p>
            <h3 class="font-['Space_Grotesk','Segoe_UI',sans-serif] text-2xl font-semibold text-foreground">Overlay and menu patterns</h3>

            <div class="mt-5 flex flex-wrap gap-2">
                @foreach (var placement in tooltipPlacements)
                {
                    <Tooltip Content="@($"Tooltip placement: {placement}")" Placement="@placement">
                        <Button Size="ButtonSize.Small" Variant="ButtonVariant.Outline" Color="ButtonColor.Gray">@placement</Button>
                    </Tooltip>
                }
            </div>

            <div class="mt-6 flex flex-wrap items-start gap-4">
                <Dropdown Inline="true" Placement="DropdownPlacement.Bottom" MenuClass="w-72">
                    <CustomTrigger>
                        <Button Variant="ButtonVariant.Outline" Color="ButtonColor.Gray">
                            <span>Button trigger menu</span>
                        </Button>
                    </CustomTrigger>

                    <ChildContent>
                        <DropdownHeader>
                            <span class="block text-sm font-semibold text-foreground">Menu preview</span>
                            <span class="block text-sm text-muted-foreground/85">Header, items, and divider in one dropdown.</span>
                        </DropdownHeader>
                        <DropdownItem Icon="@(new HomeIcon())" Href="/">Back to overview</DropdownItem>
                        <DropdownItem Icon="@(new FileIcon())" OnClick="@(() => Announce("Dropdown button item selected."))">Notify selection</DropdownItem>
                        <DropdownDivider />
                        <DropdownItem Icon="@(new GearIcon())" OnClick="@(() => Announce("Opened drawer preview from dropdown.", warning: true))">Open drawer from menu</DropdownItem>
                    </ChildContent>
                </Dropdown>

                <Dropdown Inline="true" Placement="DropdownPlacement.Bottom" MenuClass="w-72">
                    <CustomTrigger>
                        <div class="flex items-center gap-3 rounded-full border border-border/40 bg-card/75 px-4 py-1.5 shadow-[0_18px_44px_-32px_rgba(15,23,42,0.45)]  ">
                            <div class="min-w-0 text-right">
                                <div class="text-sm font-semibold text-foreground">Profile trigger</div>
                                <div class="text-xs uppercase tracking-[0.24em] text-muted-foreground/85">CustomTrigger slot</div>
                            </div>
                            <Avatar Rounded="true" Image="favicon.svg" Alt="PocketBaseSharp mark" />
                        </div>
                    </CustomTrigger>

                    <ChildContent>
                        <DropdownHeader>
                            <span class="block text-sm">PocketBaseSharp Demo</span>
                            <span class="block truncate text-sm font-medium text-muted-foreground/85">Current session: @Demo.SessionKind</span>
                        </DropdownHeader>
                        <DropdownItem Icon="@(new SearchIcon())" Href="#icons">Jump to icon gallery</DropdownItem>
                        <DropdownDivider />
                        <DropdownItem Icon="@(new ArrowRightToBracketIcon())" OnClick="@(() => Announce("Profile menu action fired."))">Send interaction message</DropdownItem>
                    </ChildContent>
                </Dropdown>
            </div>

            <div class="mt-6 flex flex-wrap gap-2">
                <Button Color="ButtonColor.Primary" OnClick="OpenLeftDrawer">Open left drawer</Button>
                <Button Variant="ButtonVariant.Outline" Color="ButtonColor.Dark" OnClick="OpenRightDrawer">Open right drawer</Button>
            </div>
        </Card>
    </div>
</section>

<section id="storytelling" class="space-y-4">
    <div>
        <p class="mb-1.5 text-[0.72rem] font-bold uppercase tracking-[0.26em] text-primary">Storytelling</p>
        <h2 class="font-['Space_Grotesk','Segoe_UI',sans-serif] text-3xl font-semibold text-foreground">Feature hero and result inspector</h2>
        <p class="mt-3 text-sm text-muted-foreground">The page header already demonstrates FeatureHero with child content. This section adds a minimal hero plus empty and populated ResultCard states.</p>
    </div>

    <FeatureHero Title="Minimal FeatureHero"
                 Description="This second hero intentionally omits ChildContent so you can see the leaner content-only presentation."
                 Eyebrow="FeatureHero"
                 Service="Page storytelling"
                 Method="Title + description + badges"
                 Access="No side panel" />

    <div class="grid gap-6 xl:grid-cols-2">
        <ResultCard Title="Live component state"
                    Description="A populated inspector showing the current state of the kitchen sink controls."
                    Json="@BuildShowcaseJson()"
                    EmptyMessage="This card is intentionally populated on every render." />

        <ResultCard Title="Empty state"
                    Description="The empty mode renders the dashed placeholder panel and helper copy."
                    EmptyMessage="Leave Json unset when you want the empty-state treatment." />
    </div>
</section>

<section id="tabs-data" class="space-y-4">
    <div>
        <p class="mb-1.5 text-[0.72rem] font-bold uppercase tracking-[0.26em] text-primary">Tabs and data</p>
        <h2 class="font-['Space_Grotesk','Segoe_UI',sans-serif] text-3xl font-semibold text-foreground">Tabs, panels, and table combinations</h2>
        <p class="mt-3 text-sm text-muted-foreground">Tabs are shown in both supported variants, and tables cover the plain, striped, hoverable, and combined states.</p>
    </div>

    <Card Class="rounded-[1.5rem] border border-border/70 bg-card/80 p-5 shadow-[0_28px_80px_-44px_rgba(15,23,42,0.35)] backdrop-blur-xl   dark:shadow-[0_30px_90px_-42px_rgba(0,0,0,0.9)]">
        <div class="grid gap-6 xl:grid-cols-2">
            <div>
                <p class="text-xs uppercase tracking-[0.24em] text-muted-foreground/85">Tabs default</p>
                <Tabs>
                    <TabListContent>
                        <Tab Index="0" Icon="@(new RocketIcon())">Overview</Tab>
                        <Tab Index="1" Icon="@(new GearIcon())">Options</Tab>
                        <Tab Index="2" Icon="@(new InfoCircleIcon())">Notes</Tab>
                    </TabListContent>
                    <TabPanelsContent>
                        <TabPanel Index="0">
                            <Card Class="mt-4 rounded-[1.25rem] border border-border/35 bg-card/70 p-4  ">
                                <p class="text-sm text-muted-foreground">Default tabs behave like lightweight segmented navigation.</p>
                            </Card>
                        </TabPanel>
                        <TabPanel Index="1">
                            <Card Class="mt-4 rounded-[1.25rem] border border-border/35 bg-card/70 p-4  ">
                                <p class="text-sm text-muted-foreground">The selected index is owned internally by the Tabs component.</p>
                            </Card>
                        </TabPanel>
                        <TabPanel Index="2">
                            <Card Class="mt-4 rounded-[1.25rem] border border-border/35 bg-card/70 p-4  ">
                                <p class="text-sm text-muted-foreground">TabListContent and TabPanelsContent are simple layout wrappers around the active state.</p>
                            </Card>
                        </TabPanel>
                    </TabPanelsContent>
                </Tabs>
            </div>

            <div>
                <p class="text-xs uppercase tracking-[0.24em] text-muted-foreground/85">Tabs pills</p>
                <Tabs Variant="TabVariant.Pills">
                    <TabListContent>
                        <Tab Index="0" Icon="@(new HomeIcon())">Public</Tab>
                        <Tab Index="1" Icon="@(new UserIcon())">Auth</Tab>
                        <Tab Index="2" Icon="@(new DatabaseIcon())">Admin</Tab>
                    </TabListContent>
                    <TabPanelsContent>
                        <TabPanel Index="0">
                            <Card Class="mt-4 rounded-[1.25rem] border border-border/35 bg-card/70 p-4  ">
                                <p class="text-sm text-muted-foreground">Pills are better when the tabs need stronger visual separation from the rest of the page.</p>
                            </Card>
                        </TabPanel>
                        <TabPanel Index="1">
                            <Card Class="mt-4 rounded-[1.25rem] border border-border/35 bg-card/70 p-4  ">
                                <p class="text-sm text-muted-foreground">This mirrors the tab treatment already used on the overview page.</p>
                            </Card>
                        </TabPanel>
                        <TabPanel Index="2">
                            <Card Class="mt-4 rounded-[1.25rem] border border-border/35 bg-card/70 p-4  ">
                                <p class="text-sm text-muted-foreground">TabPanel only renders content for the active index, which keeps the markup straightforward.</p>
                            </Card>
                        </TabPanel>
                    </TabPanelsContent>
                </Tabs>
            </div>
        </div>
    </Card>

    <div class="grid gap-6 xl:grid-cols-2">
        @foreach (var tableMode in tableModes)
        {
            <Card Class="rounded-[1.5rem] border border-border/70 bg-card/80 p-5 shadow-[0_28px_80px_-44px_rgba(15,23,42,0.35)] backdrop-blur-xl   dark:shadow-[0_30px_90px_-42px_rgba(0,0,0,0.9)]">
                <div class="flex items-center justify-between gap-3">
                    <div>
                        <p class="mb-1.5 text-[0.72rem] font-bold uppercase tracking-[0.26em] text-primary">Table family</p>
                        <h3 class="font-['Space_Grotesk','Segoe_UI',sans-serif] text-2xl font-semibold text-foreground">@tableMode.Title</h3>
                    </div>

                    <Badge Color="BadgeColor.Gray">@tableMode.Badge</Badge>
                </div>

                <div class="mt-5 overflow-x-auto">
                    <Table Striped="@tableMode.Striped" Hoverable="@tableMode.Hoverable">
                        <TableHead>
                            <TableRow>
                                <TableHeadCell>Component</TableHeadCell>
                                <TableHeadCell>Purpose</TableHeadCell>
                                <TableHeadCell>Status</TableHeadCell>
                            </TableRow>
                        </TableHead>
                        <TableBody Class="divide-y">
                            @foreach (var componentRow in tableRows)
                            {
                                <TableRow>
                                    <TableCell>@componentRow.Name</TableCell>
                                    <TableCell>@componentRow.Purpose</TableCell>
                                    <TableCell>
                                        <Badge Color="@componentRow.Color">@componentRow.Status</Badge>
                                    </TableCell>
                                </TableRow>
                            }
                        </TableBody>
                    </Table>
                </div>
            </Card>
        }
    </div>
</section>

<section id="icons" class="space-y-4">
    <div>
        <p class="mb-1.5 text-[0.72rem] font-bold uppercase tracking-[0.26em] text-primary">IconRenderer + UiTypes</p>
        <h2 class="font-['Space_Grotesk','Segoe_UI',sans-serif] text-3xl font-semibold text-foreground">All icon types defined in UiTypes.cs</h2>
        <p class="mt-3 text-sm text-muted-foreground">Each icon in the local icon set is rendered through IconRenderer so the showcase covers both the icon classes and the renderer component.</p>
    </div>

    <Card Class="rounded-[1.5rem] border border-border/70 bg-card/80 p-5 shadow-[0_28px_80px_-44px_rgba(15,23,42,0.35)] backdrop-blur-xl   dark:shadow-[0_30px_90px_-42px_rgba(0,0,0,0.9)]">
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
            @foreach (var iconSample in iconSamples)
            {
                <div class="rounded-[1.25rem] border border-border/35 bg-card/70 p-4  ">
                    <div class="flex items-center gap-3">
                        <div class="grid h-11 w-11 place-items-center rounded-2xl bg-primary/12 text-primary">
                            <IconRenderer Icon="@iconSample.Icon" Class="h-5 w-5" />
                        </div>
                        <div>
                            <p class="font-semibold text-foreground">@iconSample.Label</p>
                            <p class="text-sm text-muted-foreground">UiTypes icon</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </Card>
</section>

