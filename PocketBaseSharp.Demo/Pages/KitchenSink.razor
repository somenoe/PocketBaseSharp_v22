    private BadgeColor selectedBadgeColor = BadgeColor.Primary;
    private string onChangeValue = "admin@admin.com";
    private string onInputValue = "component catalog";
    private string disabledPasswordValue = "demo123456";
    private bool primaryToggle = true;
    private bool secondaryToggle;
    private bool isDrawerOpen;
    private DrawerPosition drawerPosition = DrawerPosition.Left;
    private string interactionMessage = "Use the controls on this page to verify the local components in real time.";
    private bool isInteractionError;
    private bool isInteractionWarning;

    private string DrawerHeading => drawerPosition == DrawerPosition.Left
        ? "Left drawer preview"
        : "Right drawer preview";

    private void OpenLeftDrawer()
    {
        OpenDrawer(DrawerPosition.Left);
    }

    private void OpenRightDrawer()
    {
        OpenDrawer(DrawerPosition.Right);
    }

    private void OpenDrawer(DrawerPosition position)
    {
        drawerPosition = position;
        isDrawerOpen = true;
        Announce($"Opened the {position.ToString().ToLowerInvariant()} drawer preview.", warning: true);
    }

    private void CloseDrawer()
    {
        isDrawerOpen = false;
        Announce("Closed the drawer preview.");
    }

    private void ResetShowcase()
    {
        selectedBadgeColor = BadgeColor.Primary;
        onChangeValue = "admin@admin.com";
        onInputValue = "component catalog";
        disabledPasswordValue = "demo123456";
        primaryToggle = true;
        secondaryToggle = false;
        isDrawerOpen = false;
        drawerPosition = DrawerPosition.Left;
        Announce("Reset the kitchen-sink page back to its default state.");
    }

    private void SelectBadgeColor(BadgeColor color)
    {
        selectedBadgeColor = color;
        Announce($"Selected the {color} badge palette.");
    }

    private void Announce(string message, bool warning = false, bool error = false)
    {
        interactionMessage = message;
        isInteractionWarning = warning && !error;
        isInteractionError = error;
    }

    private string BuildShowcaseJson()
    {
        return Demo.ToJson(new
        {
            Demo.SessionKind,
            SelectedBadgeColor = selectedBadgeColor.ToString(),
            OnChangeValue = onChangeValue,
            OnInputValue = onInputValue,
            PrimaryToggle = primaryToggle,
            SecondaryToggle = secondaryToggle,
            Drawer = isDrawerOpen ? drawerPosition.ToString() : "Closed",
            LastInteraction = interactionMessage,
        });
    }

    private sealed record QuickLink(string Title, string Copy, string Href, IconBase Icon);
    private sealed record SidebarLink(string Label, string Href, IconBase Icon);
    private sealed record TableMode(string Title, string Badge, bool Striped, bool Hoverable);
    private sealed record TableRowSample(string Name, string Purpose, string Status, BadgeColor Color);
    private sealed record IconSample(string Label, IconBase Icon);
}
