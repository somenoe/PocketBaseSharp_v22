        new("FileIcon", new FileIcon()),
        new("UsersIcon", new UsersIcon()),
        new("GridIcon", new GridIcon()),
        new("DatabaseIcon", new DatabaseIcon()),
        new("BellIcon", new BellIcon()),
        new("ExclamationTriangleIcon", new ExclamationTriangleIcon()),
        new("InfoCircleIcon", new InfoCircleIcon()),
        new("CheckCircleIcon", new CheckCircleIcon()),
