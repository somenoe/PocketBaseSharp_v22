        new("Plain table", "Base", Striped: false, Hoverable: false),
        new("Striped table", "Striped", Striped: true, Hoverable: false),
        new("Hoverable table", "Hoverable", Striped: false, Hoverable: true),
        new("Striped + hoverable table", "Combined", Striped: true, Hoverable: true),
    ];

    private static readonly TableRowSample[] tableRows =
    [
        new("Button", "Primary action surface", "Interactive", BadgeColor.Success),
        new("Dropdown", "Compact menu for actions", "Overlay", BadgeColor.Info),
        new("ResultCard", "JSON and empty-state inspector", "Diagnostic", BadgeColor.Warning),
    ];

    private static readonly IconSample[] iconSamples =
    [
        new("BarsIcon", new BarsIcon()),
        new("HomeIcon", new HomeIcon()),
        new("UserIcon", new UserIcon()),
        new("HeartIcon", new HeartIcon()),
        new("GearIcon", new GearIcon()),
