@page "/not-found"
@layout MainLayout

<PageTitle>Not Found</PageTitle>

<Card
    Class="mx-auto max-w-2xl rounded-[1.5rem] border border-white/50 bg-white/80 p-5 text-center shadow-[0_28px_80px_-44px_rgba(15,23,42,0.35)] backdrop-blur-xl dark:border-white/10 dark:bg-slate-950/80 dark:shadow-[0_30px_90px_-42px_rgba(0,0,0,0.9)]">
    <p class="mb-1.5 text-[0.72rem] font-bold uppercase tracking-[0.26em] text-orange-600 dark:text-orange-300">404</p>
    <h1 class="font-['Space_Grotesk','Segoe_UI',sans-serif] text-4xl font-semibold text-slate-900 dark:text-white">That
        feature page doesn’t exist.</h1>
        <p class="mt-4 text-base text-slate-600 dark:text-slate-300">Use the overview page to jump back into one of the SDK
            demos.</p>

            <div class="mt-6 flex flex-wrap justify-center gap-3">
                <Button Href="/" Color="ButtonColor.Primary">Go to overview</Button>
                <Button Href="/auth" Variant="ButtonVariant.Outline" Color="ButtonColor.Gray">Open auth</Button>
            </div>
        </Card>
