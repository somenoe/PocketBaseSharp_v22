@page "/"
@implements IDisposable
@inject DemoPocketBaseService Demo

<PageTitle>Overview</PageTitle>

<FeatureHero Title="PocketBaseSharp Flowbite Demo"
             Description="A local-first command deck for the SDK. Each page isolates one service surface so you can inspect auth, request paths, response payloads, and realtime behavior without dropping into the test suite."
             Eyebrow="Workspace overview" Service="PocketBase client" Method="http://127.0.0.1:8090/"
             Access="Mixed public + admin flows">
    <div class="dashboard-spotlight">
        <div class="flex items-start justify-between gap-4">
            <div>
                <p class="text-xs uppercase tracking-[0.3em] text-orange-200">Live target</p>
                <p class="mt-2 font-display text-2xl font-semibold">127.0.0.1:8090</p>
            </div>

            <Badge Color="@(Demo.IsAuthenticated ? BadgeColor.Success : BadgeColor.Gray)">@Demo.SessionKind</Badge>
        </div>

        <p class="mt-4 text-sm text-slate-300">Use the auth page to load the bundled admin credentials into <span
            class="font-semibold text-white">AuthStore</span>. Public pages like records, health, and realtime are
            useful even before you sign in.</p>

            <div class="mt-5 grid gap-3 sm:grid-cols-2">
                <div class="rounded-[1.15rem] border border-white/10 bg-white/5 p-4">
                    <p class="text-xs uppercase tracking-[0.24em] text-orange-200">Auth state</p>
                    <p class="mt-2 text-lg font-semibold text-white">@(Demo.IsAuthenticated ? "Token loaded" : "Anonymous")
                    </p>
                    <p class="mt-2 text-sm text-slate-300">@(Demo.CurrentEmail ?? "Sign in only when you need admin-only pages.")</p>
                </div>

                <div class="rounded-[1.15rem] border border-white/10 bg-white/5 p-4">
                    <p class="text-xs uppercase tracking-[0.24em] text-orange-200">Last request</p>
                    <p class="mt-2 text-lg font-semibold text-white">@(Demo.LastRequestMethod ?? "Idle")</p>
                    <p class="mt-2 text-sm text-slate-300">@(Demo.LastRequestPath ?? "No network traffic captured yet.")</p>
                </div>
            </div>

            <div class="mt-5 flex flex-wrap gap-3">
                <Button Href="/auth" Color="ButtonColor.Primary">Open auth</Button>
                <Button Href="/records" Variant="ButtonVariant.Outline" Color="ButtonColor.Gray">Browse records</Button>
            </div>
        </div>
    </FeatureHero>

    <Alert Color="AlertColor.Info" Icon="@(new InfoCircleIcon())" TextEmphasis="Quick start"
           Text="1) Run just pb. 2) Open Auth and sign in as admin@admin.com / demo123456. 3) Use the other pages to exercise one SDK area at a time." />

    <Tabs Variant="TabVariant.Pills">
        <TabListContent>
            <Tab Index="0" Icon="@(new RocketIcon())">Launch runbook</Tab>
            <Tab Index="1" Icon="@(new GridIcon())">Service map</Tab>
            <Tab Index="2" Icon="@(new LockIcon())">Access model</Tab>
        </TabListContent>
        <TabPanelsContent>
            <TabPanel Index="0">
                <div class="mt-5 grid gap-4 lg:grid-cols-3">
                    @foreach (var step in runbookSteps)
                    {
                        <Card Class="panel-surface p-5 transition-transform duration-200 hover:-translate-y-1">
                            <div class="flex items-start gap-4">
                                <div class="launch-step-index">@step.Order</div>
                                <div>
                                    <p class="section-kicker">Step @step.Order</p>
                                    <h2 class="font-display text-2xl font-semibold text-slate-900 dark:text-white">@step.Title
                                    </h2>
                                    <p class="mt-3 text-sm text-slate-600 dark:text-slate-300">@step.Copy</p>
                                    <Button Href="@step.Href"
                                            Color="@(step.Order == 1 ? ButtonColor.Primary : ButtonColor.Gray)"
                                            Variant="@(step.Order == 1 ? ButtonVariant.Default : ButtonVariant.Outline)"
                                            Class="mt-5">
                                        @step.ActionLabel
                                    </Button>
                                </div>
                            </div>
                        </Card>
                    }
                </div>
            </TabPanel>

            <TabPanel Index="1">
                <div class="mt-5 grid gap-4 lg:grid-cols-3">
                    @foreach (var cluster in serviceClusters)
                    {
                        <Card Class="panel-surface p-5 transition-transform duration-200 hover:-translate-y-1">
                            <p class="section-kicker">@cluster.Kicker</p>
                            <h2 class="font-display text-2xl font-semibold text-slate-900 dark:text-white">@cluster.Title</h2>
                            <p class="mt-3 text-sm text-slate-600 dark:text-slate-300">@cluster.Copy</p>
                            <div class="mt-4 flex flex-wrap gap-2">
                                @foreach (var pageName in cluster.Pages)
                                {
                                    <Badge Color="@cluster.Color">@pageName</Badge>
                                }
                            </div>
                        </Card>
                    }
                </div>
            </TabPanel>

            <TabPanel Index="2">
                <div class="mt-5 grid gap-4 lg:grid-cols-3">
                    @foreach (var mode in accessModes)
                    {
                        <Card Class="panel-surface p-5 transition-transform duration-200 hover:-translate-y-1">
                            <div class="flex items-center justify-between gap-3">
                                <p class="section-kicker">Access tier</p>
                                <Badge Color="@mode.Color">@mode.Badge</Badge>
                            </div>
                            <h2 class="font-display text-2xl font-semibold text-slate-900 dark:text-white">@mode.Title</h2>
                            <p class="mt-3 text-sm text-slate-600 dark:text-slate-300">@mode.Copy</p>
                        </Card>
                    }
                </div>
            </TabPanel>
        </TabPanelsContent>
    </Tabs>

    <Card Class="panel-surface overflow-hidden p-0">
        <div class="p-5">
            <div class="flex flex-col gap-4 border-b border-black/5 pb-5 dark:border-white/10">
                <div>
                    <p class="section-kicker">Explorer</p>
                    <h2 class="font-display text-3xl font-semibold text-slate-900 dark:text-white">Browse demo surfaces</h2>
                    <p class="mt-3 text-sm text-slate-600 dark:text-slate-300">Use the search field to narrow the service
                        pages
                        by name, access level, or the SDK surface they focus on.</p>
                    </div>

                    <Toolbar Embedded="true"
                             Class="w-full rounded-[1.25rem] border border-white/40 bg-white/55 px-4 py-3 dark:border-white/10 dark:bg-slate-950/45">
                        <ChildContent>
                            <TextInput TValue="string" @bind-Value="searchQuery" Behavior="InputBehavior.OnInput"
                                       DebounceDelay="200" Placeholder="Search pages, services, or access level"
                                       Icon="@(new SearchIcon())" Class="w-full lg:w-96" />
                        </ChildContent>
                        <End>
                            <Badge Color="BadgeColor.Gray">@($"Showing {FilteredFeatures.Count} pages")</Badge>
                        </End>
                    </Toolbar>
                </div>

                @if (FilteredFeatures.Count == 0)
                {
                    <div class="py-8 text-sm text-slate-600 dark:text-slate-300">No pages match the current search query.</div>
                }
                else
                {
                    <div class="mt-6 grid gap-4 md:grid-cols-2 2xl:grid-cols-3">
                        @foreach (var feature in FilteredFeatures)
                        {
                            <Card Href="@feature.Href"
                                  Class="feature-explorer-card p-5 transition-transform duration-200 hover:-translate-y-1">
                                <div class="flex items-start justify-between gap-3">
                                    <div>
                                        <p class="section-kicker">@feature.Category</p>
                                        <h2 class="font-display text-2xl font-semibold text-slate-900 dark:text-white">@feature.Title
                                        </h2>
                                    </div>
                                    <Badge
                                        Color="@(feature.Access.Contains("Admin", StringComparison.OrdinalIgnoreCase) ? BadgeColor.Warning : BadgeColor.Success)">
                                        @feature.Access</Badge>
                                    </div>

                                    <p class="mt-3 text-sm text-slate-600 dark:text-slate-300">@feature.Copy</p>

                                    <div class="mt-4 flex flex-wrap gap-2">
                                        <Badge Color="BadgeColor.Primary">@feature.Service</Badge>
                                        <Badge Color="BadgeColor.Info">@feature.Method</Badge>
                                    </div>

                                    <p class="mt-5 text-sm font-semibold text-slate-900 dark:text-slate-200">Open page</p>
                                </Card>
                            }
                        </div>
                    }
                </div>
            </Card>

            <div class="grid gap-6 xl:grid-cols-[0.9fr_1.1fr]">
                <Card Class="panel-surface overflow-hidden p-0">
                    <div class="p-5">
                        <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
                            <div>
                                <p class="section-kicker">Session</p>
                                <h2 class="font-display text-2xl font-semibold text-slate-900 dark:text-white">Current client state
                                </h2>
                            </div>
                            <Badge Color="@(Demo.IsAuthenticated ? BadgeColor.Success : BadgeColor.Gray)">@Demo.SessionKind</Badge>
                        </div>

                        <div class="mt-5 grid gap-3 sm:grid-cols-2">
                            <div class="shell-stat-card">
                                <p class="shell-stat-label">Session kind</p>
                                <p class="shell-stat-value">@Demo.SessionKind</p>
                                <p class="shell-stat-copy">Current auth model in AuthStore</p>
                            </div>

                            <div class="shell-stat-card">
                                <p class="shell-stat-label">Auth state</p>
                                <p class="shell-stat-value">@(Demo.IsAuthenticated ? "Valid token" : "Anonymous")</p>
                                <p class="shell-stat-copy">Admin-only pages unlock after sign-in</p>
                            </div>

                            <div class="shell-stat-card">
                                <p class="shell-stat-label">Current email</p>
                                <p class="shell-stat-value">@(Demo.CurrentEmail ?? "Not signed in")</p>
                                <p class="shell-stat-copy">Identity captured from the active auth model</p>
                            </div>

                            <div class="shell-stat-card">
                                <p class="shell-stat-label">Last request</p>
                                <p class="shell-stat-value">@(Demo.LastRequestMethod ?? "Idle")</p>
                                <p class="shell-stat-copy">@(Demo.LastRequestPath ?? "No network traffic yet")</p>
                            </div>
                        </div>
                    </div>
                </Card>

                <ResultCard Title="Client inspector"
                            Description="This mirrors the demo service state and the SDK request/response event hooks."
                            Json="@BuildInspectorJson()" EmptyMessage="Open a page and trigger an action to populate the inspector." />
            </div>

@code {
    private readonly FeatureCard[] features =
    [
        new("Health", "/health", "Ping the local server with HealthService.CheckHealthAsync().", "HealthService", "Public",
"Diagnostics", "CheckHealthAsync()"),
        new("Auth", "/auth", "Load auth methods, sign in as admin, create a user, and inspect AuthStore.", "UserService + AuthStore", "Public + admin", "Identity", "AuthenticateWithPasswordAsync()"),
        new("Records", "/records", "Create, list, edit, and delete entry records with RecordService.", "RecordService",
"Public", "CRUD", "ListAsync(), CreateAsync()"),
        new("Users", "/users", "Create and patch auth records using the user service wrappers.", "UserService", "Admin", "Admin tools", "ListAsync(), UpdateAsync()"),
        new("Collections", "/collections", "Inspect collection metadata and lookup schema by collection name.",
"CollectionService", "Admin", "Schema", "ListAsync(), GetByNameAsync()"),
        new("Settings", "/settings", "Read and patch application settings plus run diagnostics.", "SettingsService", "Admin",
"Diagnostics", "GetAllAsync(), UpdateAsync()"),
        new("Backups", "/backups", "Create, list, stream, and delete backups from the SDK.", "BackupService", "Admin",
"Operations", "GetFullListAsync(), CreateAsync()"),
        new("Realtime", "/realtime", "Subscribe to entry events and create records to watch the SSE stream.", "RealTimeService",
"Public", "Streaming", "SubscribeAsync()"),
    ];
    private readonly RunbookStep[] runbookSteps =
    [
        new(1, "Confirm the local server", "Kick off with the health page so you know the SDK can reach the bundled PocketBase instance before testing richer flows.", "/health", "Run health checks"),
        new(2, "Load credentials when needed", "The auth workspace handles both collection auth and the legacy admin bootstrap path required for the bundled local server.", "/auth", "Open auth workspace"),
        new(3, "Exercise one service at a time", "Jump to records, users, collections, backups, or realtime and inspect the payloads without leaving the browser.", "/records", "Open service pages"),
    ];
    private readonly ServiceCluster[] serviceClusters =
    [
        new("Public routes", "No sign-in required. Use these pages for fast connectivity checks and collection CRUD against the open demo data.", ["Health", "Records", "Realtime"], BadgeColor.Success),
        new("Identity flows", "These pages explain how AuthStore changes after user sign-in, admin bootstrap, refresh, and logout operations.", ["Auth", "Users"], BadgeColor.Info),
        new("Admin diagnostics", "Schema, settings, and backup flows sit behind admin auth and are useful once the token is loaded.", ["Collections", "Settings", "Backups"], BadgeColor.Warning),
    ];
    private readonly AccessMode[] accessModes =
    [
        new("Anonymous", "Best for health checks, public entry CRUD, and realtime experimentation. You can learn the request surface immediately.", "Instant access", BadgeColor.Gray),
        new("User", "Useful for collection auth and refresh flows. This shows how the SDK behaves when AuthStore contains a standard user model.", "Collection auth", BadgeColor.Info),
        new("Admin", "Required for users, collections, settings, and backups. The auth page loads the bundled credentials into AuthStore for you.", "Admin-only pages", BadgeColor.Success),
    ];
    private string searchQuery = string.Empty;

    private List<FeatureCard> FilteredFeatures =>
        features
            .Where(feature =>
                string.IsNullOrWhiteSpace(searchQuery)
                || feature.Title.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)
                || feature.Service.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)
                || feature.Access.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)
                || feature.Category.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)
                || feature.Method.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)
                || feature.Copy.Contains(searchQuery, StringComparison.OrdinalIgnoreCase))
            .ToList();

    protected override void OnInitialized()
    {
        Demo.Changed += HandleChanged;
    }

    private string BuildInspectorJson()
    {
        return Demo.ToJson(new
        {
            Demo.SessionKind,
            Demo.IsAuthenticated,
            Demo.CurrentEmail,
            Demo.CurrentId,
            Demo.TokenPreview,
            LastRequest = Demo.LastRequestUrl?.ToString(),
            Demo.LastRequestMethod,
            StatusCode = Demo.LastStatusCode is null ? (int?)null : (int)Demo.LastStatusCode,
            Demo.LastRequestAt,
        });
    }

    private void HandleChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Demo.Changed -= HandleChanged;
    }

    private sealed record FeatureCard(string Title, string Href, string Copy, string Service, string Access, string
Category, string Method);
    private sealed record RunbookStep(int Order, string Title, string Copy, string Href, string ActionLabel);
    private sealed record ServiceCluster(string Title, string Copy, string[] Pages, BadgeColor Color)
    {
        public string Kicker => Title;
    }

    private sealed record AccessMode(string Title, string Copy, string Badge, BadgeColor Color);
}
