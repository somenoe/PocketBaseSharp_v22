@if (!string.IsNullOrWhiteSpace(Href) && !Disabled && !Loading)
{
    <a href="@Href" class="@ResolveClass()">
        @if (Loading)
        {
            <span class="@SpinnerClass()"></span>
        }
        @ChildContent
    </a>
}
else
{
    <button type="@Type" class="@ResolveClass()" @onclick="OnClick" disabled="@(Disabled || Loading)">
        @if (Loading)
        {
            <span class="@SpinnerClass()"></span>
        }
        @ChildContent
    </button>
}

@code {
    [Parameter]
    public string? Href { get; set; }

    [Parameter]
    public string Type { get; set; } = "button";

    [Parameter]
    public ButtonColor Color { get; set; } = ButtonColor.Primary;

    [Parameter]
    public ButtonVariant Variant { get; set; } = ButtonVariant.Default;

    [Parameter]
    public ButtonSize Size { get; set; } = ButtonSize.Default;

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool Loading { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public EventCallback OnClick { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private string ResolveClass()
    {
        var size = Size == ButtonSize.Small
            ? "min-h-9 px-3 py-2 text-xs tracking-[0.18em]"
            : "min-h-11 px-4 py-2.5 text-sm tracking-[0.2em]";

        var palette = (Variant, Color) switch
        {
            (ButtonVariant.Outline, ButtonColor.Primary) => "border border-primary/30 bg-card/75 text-primary hover:border-primary/45 hover:bg-primary/10",
            (ButtonVariant.Outline, ButtonColor.Dark) => "border border-border/70 bg-card/75 text-foreground hover:border-border hover:bg-muted/80",
            (ButtonVariant.Outline, ButtonColor.Red) => "border border-destructive/30 bg-card/75 text-destructive hover:border-destructive/45 hover:bg-destructive/10",
            (ButtonVariant.Outline, _) => "border border-border/70 bg-card/75 text-foreground hover:border-border hover:bg-muted/80",
            (_, ButtonColor.Gray) => "bg-secondary text-secondary-foreground hover:bg-muted",
            (_, ButtonColor.Dark) => "bg-foreground text-background hover:bg-foreground/90",
            (_, ButtonColor.Red) => "bg-destructive text-destructive-foreground hover:bg-destructive/90",
            _ => "bg-primary text-primary-foreground hover:bg-primary/90",
        };

        var disabled = Disabled || Loading ? "cursor-not-allowed opacity-60" : string.Empty;
        return $"inline-flex items-center justify-center gap-2 rounded-full font-semibold uppercase transition duration-200 {size} {palette} {disabled} {Class}".Trim();
    }

    private string SpinnerClass() => Size == ButtonSize.Small
        ? "h-3.5 w-3.5 animate-spin rounded-full border-2 border-current border-r-transparent"
        : "h-4 w-4 animate-spin rounded-full border-2 border-current border-r-transparent";
}
