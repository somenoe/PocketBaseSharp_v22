@if (!string.IsNullOrWhiteSpace(Href) && !Disabled && !Loading)
{
    <a href="@Href" class="@ResolveClass()">
        @if (Loading)
        {
            <span class="@SpinnerClass()"></span>
        }
        @ChildContent
    </a>
}
else
{
    <button type="@Type" class="@ResolveClass()" @onclick="OnClick" disabled="@(Disabled || Loading)">
        @if (Loading)
        {
            <span class="@SpinnerClass()"></span>
        }
        @ChildContent
    </button>
}

@code {
    [Parameter]
    public string? Href { get; set; }

    [Parameter]
    public string Type { get; set; } = "button";

    [Parameter]
    public ButtonColor Color { get; set; } = ButtonColor.Primary;

    [Parameter]
    public ButtonVariant Variant { get; set; } = ButtonVariant.Default;

    [Parameter]
    public ButtonSize Size { get; set; } = ButtonSize.Default;

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool Loading { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public EventCallback OnClick { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private string ResolveClass()
    {
        var size = Size == ButtonSize.Small
            ? "min-h-9 px-3 py-2 text-xs tracking-[0.18em]"
            : "min-h-11 px-4 py-2.5 text-sm tracking-[0.2em]";

        var palette = (Variant, Color) switch
        {
            (ButtonVariant.Outline, ButtonColor.Primary) => "border border-orange-300/70 bg-white/75 text-orange-700 hover:border-orange-400 hover:bg-orange-50 dark:border-orange-400/30 dark:bg-slate-950/65 dark:text-orange-200 dark:hover:bg-orange-500/10",
            (ButtonVariant.Outline, ButtonColor.Dark) => "border border-slate-300/70 bg-white/75 text-slate-700 hover:border-slate-400 hover:bg-slate-100 dark:border-white/15 dark:bg-slate-950/65 dark:text-slate-100 dark:hover:bg-slate-900",
            (ButtonVariant.Outline, ButtonColor.Red) => "border border-rose-300/70 bg-white/75 text-rose-700 hover:border-rose-400 hover:bg-rose-50 dark:border-rose-400/30 dark:bg-slate-950/65 dark:text-rose-200 dark:hover:bg-rose-500/10",
            (ButtonVariant.Outline, _) => "border border-slate-300/70 bg-white/75 text-slate-700 hover:border-slate-400 hover:bg-slate-100 dark:border-white/15 dark:bg-slate-950/65 dark:text-slate-100 dark:hover:bg-slate-900",
            (_, ButtonColor.Gray) => "bg-slate-100 text-slate-800 hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-100 dark:hover:bg-slate-700",
            (_, ButtonColor.Dark) => "bg-slate-900 text-white hover:bg-slate-800 dark:bg-white dark:text-slate-950 dark:hover:bg-slate-100",
            (_, ButtonColor.Red) => "bg-rose-600 text-white hover:bg-rose-500 dark:bg-rose-500 dark:hover:bg-rose-400",
            _ => "bg-orange-500 text-white hover:bg-orange-400 dark:bg-orange-500 dark:hover:bg-orange-400",
        };

        var disabled = Disabled || Loading ? "cursor-not-allowed opacity-60" : string.Empty;
        return $"inline-flex items-center justify-center gap-2 rounded-full font-semibold uppercase transition duration-200 {size} {palette} {disabled} {Class}".Trim();
    }

    private string SpinnerClass() => Size == ButtonSize.Small
        ? "h-3.5 w-3.5 animate-spin rounded-full border-2 border-current border-r-transparent"
        : "h-4 w-4 animate-spin rounded-full border-2 border-current border-r-transparent";
}
