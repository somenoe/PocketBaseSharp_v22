<span class="@ResolveClass()">
    @ChildContent
</span>

@code {
    [Parameter]
    public BadgeColor Color { get; set; } = BadgeColor.Gray;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private string ResolveClass()
    {
        var palette = Color switch
        {
            BadgeColor.Primary => "bg-primary/12 text-primary ring-primary/20",
            BadgeColor.Info => "bg-info/12 text-info ring-info/20",
            BadgeColor.Success => "bg-success/12 text-success ring-success/20",
            BadgeColor.Warning => "bg-warning/14 text-warning ring-warning/20",
            BadgeColor.Pink => "bg-destructive/12 text-destructive ring-destructive/20",
            _ => "bg-muted text-muted-foreground ring-border",
        };

        return $"inline-flex items-center rounded-full px-3 py-1 text-[0.72rem] font-semibold uppercase tracking-[0.18em] ring-1 ring-inset {palette}";
    }
}
