<li class="inline-flex items-center gap-2">
    @if (!string.IsNullOrWhiteSpace(Href))
    {
        <a href="@Href" class="inline-flex items-center gap-2 rounded-full px-3 py-1.5 transition hover:bg-accent hover:text-accent-foreground">
            @ChildContent
        </a>
    }
    else
    {
        <span class="inline-flex items-center gap-2 rounded-full bg-secondary px-3 py-1.5 text-secondary-foreground">
            @ChildContent
        </span>
    }
</li>

@code {
    [Parameter]
    public string? Href { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
