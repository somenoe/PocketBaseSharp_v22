<li class="inline-flex items-center gap-2">
    @if (!string.IsNullOrWhiteSpace(Href))
    {
        <a href="@Href" class="inline-flex items-center gap-2 rounded-full px-3 py-1.5 transition hover:bg-slate-100 hover:text-slate-900 dark:hover:bg-slate-900 dark:hover:text-white">
            @ChildContent
        </a>
    }
    else
    {
        <span class="inline-flex items-center gap-2 rounded-full bg-slate-100 px-3 py-1.5 text-slate-800 dark:bg-slate-800 dark:text-slate-100">
            @ChildContent
        </span>
    }
</li>

@code {
    [Parameter]
    public string? Href { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
