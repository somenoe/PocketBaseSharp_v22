@if (Tabs is not null)
{
    <button type="button" class="@ResolveClass()" @onclick="() => Tabs.Select(Index)">
        @if (Icon is not null)
        {
            <IconRenderer Icon="@Icon" Class="h-4 w-4 shrink-0" />
        }
        <span>@ChildContent</span>
    </button>
}

@code {
    [CascadingParameter]
    public Tabs? Tabs { get; set; }

    [Parameter]
    public int Index { get; set; }

    [Parameter]
    public IconBase? Icon { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private string ResolveClass()
    {
        var isActive = Tabs?.SelectedIndex == Index;
        var active = isActive
            ? "bg-primary text-primary-foreground shadow-lg"
            : "text-muted-foreground hover:bg-accent hover:text-accent-foreground";
        return $"inline-flex items-center gap-2 rounded-full px-4 py-2 text-sm font-semibold transition {active}";
    }
}
