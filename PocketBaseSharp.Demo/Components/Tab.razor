@if (Tabs is not null)
{
    <button type="button" class="@ResolveClass()" @onclick="() => Tabs.Select(Index)">
        @if (Icon is not null)
        {
            <IconRenderer Icon="@Icon" Class="h-4 w-4 shrink-0" />
        }
        <span>@ChildContent</span>
    </button>
}

@code {
    [CascadingParameter]
    public Tabs? Tabs { get; set; }

    [Parameter]
    public int Index { get; set; }

    [Parameter]
    public IconBase? Icon { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private string ResolveClass()
    {
        var isActive = Tabs?.SelectedIndex == Index;
        var active = isActive
            ? "bg-orange-500 text-white shadow-[0_18px_40px_-28px_rgba(234,88,12,0.65)]"
            : "text-slate-600 hover:bg-slate-100 hover:text-slate-900 dark:text-slate-300 dark:hover:bg-slate-900 dark:hover:text-white";
        return $"inline-flex items-center gap-2 rounded-full px-4 py-2 text-sm font-semibold transition {active}";
    }
}
