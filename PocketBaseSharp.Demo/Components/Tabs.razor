<CascadingValue Value="this">
    <div class="space-y-4">
        @ChildContent
    </div>
</CascadingValue>

@code {
    [Parameter]
    public TabVariant Variant { get; set; } = TabVariant.Default;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    internal int SelectedIndex { get; private set; }

    internal string TabListClass => Variant == TabVariant.Pills
        ? "inline-flex flex-wrap gap-2 rounded-[1.25rem] border border-border/60 bg-card/70 p-2"
        : "inline-flex flex-wrap gap-2";

    internal void Select(int index)
    {
        SelectedIndex = index;
        StateHasChanged();
    }
}
