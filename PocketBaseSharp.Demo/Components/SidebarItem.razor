@inject NavigationManager Navigation

<a href="@Href" class="@ResolveClass()">
    @if (Icon is not null)
    {
        <IconRenderer Icon="@Icon" Class="h-4 w-4 shrink-0" />
    }
    <span class="truncate">@ChildContent</span>
</a>

@code {
    [Parameter]
    public string Href { get; set; } = "/";

    [Parameter]
    public IconBase? Icon { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private string ResolveClass()
    {
        var current = "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/');
        if (current == "/")
        {
            current = "/";
        }

        var active = string.Equals(current, Href, StringComparison.OrdinalIgnoreCase)
            ? "bg-orange-500 text-white shadow-[0_18px_40px_-28px_rgba(234,88,12,0.7)]"
            : "text-slate-700 hover:bg-slate-100/80 hover:text-slate-900 dark:text-slate-200 dark:hover:bg-slate-900/80 dark:hover:text-white";

        return $"flex items-center gap-3 rounded-[1rem] px-3 py-2.5 text-sm font-semibold transition {active}";
    }
}
