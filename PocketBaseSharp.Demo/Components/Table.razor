<table class="@ResolveClass()">
    @ChildContent
</table>

@code {
    [Parameter]
    public bool Striped { get; set; }

    [Parameter]
    public bool Hoverable { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private string ResolveClass()
    {
        var striped = Striped ? "[&_tbody_tr:nth-child(even)]:bg-muted/55" : string.Empty;
        var hoverable = Hoverable ? "[&_tbody_tr]:transition-colors [&_tbody_tr:hover]:bg-accent/70" : string.Empty;
        return $"min-w-full border-separate border-spacing-0 text-left text-sm text-muted-foreground {striped} {hoverable} {Class}".Trim();
    }
}
