<label for="@For" class="text-sm font-semibold text-foreground">
    @if (ChildContent is not null)
    {
        @ChildContent
    }
    else
    {
        @Value
    }
</label>

@code {
    [Parameter]
    public string? For { get; set; }

    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
