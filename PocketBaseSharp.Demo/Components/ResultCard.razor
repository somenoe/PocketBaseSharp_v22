<Card Class="panel-surface overflow-hidden p-0">
    <div class="flex items-start justify-between gap-3 px-5 py-5">
        <div>
            <p class="section-kicker">Inspector</p>
            <h2 class="font-display text-xl font-semibold text-slate-900 dark:text-white">@Title</h2>
            @if (!string.IsNullOrWhiteSpace(Description))
            {
                <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">@Description</p>
            }
        </div>
        <Badge Color="BadgeColor.Gray">JSON</Badge>
    </div>

    <div class="px-5 pb-5">
        @if (string.IsNullOrWhiteSpace(Json))
        {
            <EmptyState Title="No payload yet" Description="@EmptyMessage">
                <Icon>
                    <ClipboardArrowIcon class="h-12 w-12 text-slate-400 dark:text-slate-500" />
                </Icon>
            </EmptyState>
        }
        else
        {
            <pre class="result-pre max-h-80">@Json</pre>
        }
    </div>
</Card>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public string? Json { get; set; }

    [Parameter]
    public string EmptyMessage { get; set; } = "Run an action to inspect the response payload.";
}
