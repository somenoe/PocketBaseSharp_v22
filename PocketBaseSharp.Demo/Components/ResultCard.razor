<Card
    Class="overflow-hidden rounded-[1.5rem] border border-border/70 bg-card/80 p-0 shadow-[0_28px_80px_-44px_rgba(15,23,42,0.35)] backdrop-blur-xl   dark:shadow-[0_30px_90px_-42px_rgba(0,0,0,0.9)]">
    <div class="flex items-start justify-between gap-3 px-5 py-5">
        <div>
            <p class="mb-1.5 text-[0.72rem] font-bold uppercase tracking-[0.26em] text-primary">
                Inspector</p>
                <h2
                    class="font-['Space_Grotesk','Segoe_UI',sans-serif] text-xl font-semibold text-foreground">
                    @Title</h2>
                    @if (!string.IsNullOrWhiteSpace(Description))
                    {
                        <p class="mt-2 text-sm text-muted-foreground">@Description</p>
                    }
                </div>
                <Badge Color="BadgeColor.Gray">JSON</Badge>
            </div>

            <div class="px-5 pb-5">
                @if (string.IsNullOrWhiteSpace(Json))
                {
                    <div class="grid min-h-44 place-items-center rounded-[1rem] border border-dashed border-border/50 bg-muted/60 p-6 text-center">
                        <div class="space-y-3">
                            <ClipboardArrowIcon class="mx-auto h-12 w-12 text-muted-foreground/65" />
                            <div>
                                <p class="text-sm font-semibold uppercase tracking-[0.22em] text-muted-foreground/85">No payload yet</p>
                                <p class="mt-2 text-sm text-muted-foreground">@EmptyMessage</p>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <pre
                    class="max-h-80 overflow-x-auto rounded-[1rem] bg-panel-strong p-4 text-[0.78rem] leading-[1.45] text-panel-strong-muted">@Json</pre>
                }
            </div>
        </Card>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public string? Json { get; set; }

    [Parameter]
    public string EmptyMessage { get; set; } = "Run an action to inspect the response payload.";
}
