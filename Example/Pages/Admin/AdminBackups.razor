@page "/admin/backups"
@using Example.Pages.Admin.Components
@using PocketBaseSharp.Models

<AuthorizeView>
    <Authorized>
        <BackupManagement />
    </Authorized>
    <NotAuthorized>
        <MudCard>
            <MudCardContent>
                <MudText>Access Denied. Please <MudLink Href="/admin/login">login as admin</MudLink>.</MudText>
            </MudCardContent>
        </MudCard>
    </NotAuthorized>
</AuthorizeView>
