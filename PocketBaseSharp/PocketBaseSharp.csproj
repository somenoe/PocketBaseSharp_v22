<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<PackageId>PocketBaseSharp</PackageId>
		<PackageVersion>1.1.0</PackageVersion>
		<RootNamespace>PocketBaseSharp</RootNamespace>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<PackageProjectUrl>https://github.com/PSCourtney/PocketBaseSharp</PackageProjectUrl>
		<RepositoryUrl>https://github.com/PSCourtney/PocketBaseSharp</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<Title>PocketBaseSharp</Title>
		<Authors>Piers Courtney</Authors>
		<Description>Multiplatform C# SDK for PocketBase</Description>
		<PackageTags>pocketbase;blazor;webassembly;dotnet;sdk;api;realtime;backend;database;authentication</PackageTags>
		<Copyright>Copyright (c) 2025 PSCourtney</Copyright>
		<PackageReleaseNotes>Version 1.1.0: Added backup management features (create, download, restore, delete backups). Compatible with PocketBase v0.35.1 and .NET 10.</PackageReleaseNotes>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>icon.png</PackageIcon>
		<IncludeSymbols>True</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>latest</LangVersion>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\LICENSE.txt">
		  <Pack>True</Pack>
		  <PackagePath>\</PackagePath>
		</None>
		<None Include="..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="icon.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="C:\Users\Lukas\source\repos\pocketbase-csharp-sdk\pocketbase-csharp-sdk\.editorconfig" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="FluentResults" Version="4.0.0" />
	  <PackageReference Include="MimeMapping" Version="3.1.0" />
	</ItemGroup>

	<ItemGroup>
	  <EditorConfigFiles Remove="C:\Users\Lukas\source\repos\pocketbase-csharp-sdk\pocketbase-csharp-sdk\.editorconfig" />
	</ItemGroup>

</Project>
